{
  "name": "blind-bottle",
  "private": true,
  "version": "1.12.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "preview:watch": "node scripts/preview-watch.mjs",
    "build:ios": "tsc --noEmit && vite build --mode ios",
    "ios:sync": "npm run build:ios && cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource/cinzel": "^5.2.5",
    "@fontsource/cormorant-garamond": "^5.2.5",
    "@fontsource/great-vibes": "^5.2.5",
    "@fontsource/oswald": "^5.2.5",
    "@fontsource/playfair-display": "^5.2.5",
    "@fontsource/unifrakturmaguntia": "^5.2.5",
    "animejs": "^4.5.0",
    "country-flag-emoji-polyfill": "^0.1.10",
    "firebase": "^12.19.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "iosVersion": "1.0.0"
}
